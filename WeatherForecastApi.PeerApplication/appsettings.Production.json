{
  "KeyVault": {
    "VaultUri": "https://<prod-vault-name>.vault.azure.net/",
    "DbSecretName": "weatherforecast-db",
    "AppSecretName": "weatherforecast-app"
  },
  "ConnectionStrings": {
    "Host": "<prod-pg-host>",
    "Port": "5432",
    "Database": "weatherforecast",
    "Schema": "public",
    "SslMode": "Require"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  }
}
